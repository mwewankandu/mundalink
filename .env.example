# Copy this file to .env and paste your own key.
# Get a key from https://console.x.ai/
# Leave this blank to browse listings and prices without chat.
# Never commit the real .env file.
XAI_API_KEY=

# Optional. Which Grok model to call. Default is grok-4.7.
XAI_MODEL=grok-4.7

# Optional. The port the website uses. Default is 3000.
PORT=3000
